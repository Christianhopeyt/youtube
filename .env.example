# Copy this file to .env and fill in your keys. .env is git-ignored.
# Keep these keys server-side only (used by netlify/functions). Never put them in client-side JS.

# REQUIRED — Google Cloud API key with the "YouTube Data API v3" enabled.
# Used by /api/creator-dashboard, /api/channel-analyzer, /api/niche-insights.
# Without it these endpoints return 503 API_NOT_CONFIGURED.
YT_API_KEY=

# REQUIRED only for AI features (Creator Dashboard "Ideas" tab, Niche Insights AI suggestions).
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OPTIONAL — defaults to gemini-2.5-flash in netlify/functions/lib/*.js if unset.
GEMINI_MODEL=gemini-2.5-flash
